<Project Sdk="Microsoft.NET.Sdk">

  <!-- Habits, streak rules, local storage and the sharing client. No UI references, so tests run with plain
       `dotnet test` and a future widget provider can share it with the app. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>RepDayrise.Core</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RepDayrise.Core.Tests" />
  </ItemGroup>

</Project>
