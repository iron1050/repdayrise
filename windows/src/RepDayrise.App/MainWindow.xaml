<Window
    x:Class="RepDayrise.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RepDayrise.Controls"
    Title="RepDayrise">

    <!--
        Full-bleed shell like the Android app: pages draw edge to edge (the sky runs under the title bar),
        round buttons sit top-left, and a floating bar at the bottom switches between Focus, Progress and Habits.
    -->
    <Grid x:Name="Root" Background="{ThemeResource AppBackgroundBrush}">
        <Frame x:Name="ContentFrame" Navigated="OnNavigated" />

        <!-- Window drag area along the top; its left edge moves to clear the buttons. -->
        <Border x:Name="DragRegion" Height="48" VerticalAlignment="Top" Background="Transparent" />

        <StackPanel x:Name="TopChrome" Orientation="Horizontal" Spacing="8" Margin="14,6,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Top">
            <Button x:Name="BackButton" Style="{StaticResource BarButtonStyle}" Width="40" Height="40" CornerRadius="20"
                    Click="OnBack" Visibility="Collapsed" ToolTipService.ToolTip="Back (Esc)" AutomationProperties.Name="Back">
                <FontIcon Glyph="&#xE72B;" FontSize="16" />
            </Button>
            <Button x:Name="SettingsButton" Style="{StaticResource BarButtonStyle}" Width="40" Height="40" CornerRadius="20"
                    Click="OnSettings" ToolTipService.ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings">
                <FontIcon Glyph="&#xE713;" FontSize="16" />
            </Button>
            <Button x:Name="PartnersButton" Style="{StaticResource BarButtonStyle}" Width="40" Height="40" CornerRadius="20"
                    Click="OnPartners" ToolTipService.ToolTip="Partners (Ctrl+4)" AutomationProperties.Name="Partners">
                <FontIcon Glyph="&#xE716;" FontSize="16" />
            </Button>
        </StackPanel>

        <controls:FloatingBar x:Name="Bar" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20" />
    </Grid>
</Window>
