<Window
    x:Class="RepDayrise.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="RepDayrise">

    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <!--
        A native title bar carries the navigation: Focus, Progress and Habits as a SelectorBar in the middle, with a
        live timer capsule (while a session runs elsewhere), Partners and Settings on the right. Pages draw under it.
    -->
    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Frame x:Name="ContentFrame" Grid.RowSpan="2" Navigated="OnNavigated" />

        <TitleBar x:Name="AppTitleBar" Height="48" IsBackButtonVisible="False" BackRequested="OnBackRequested">
            <!-- Mirrors the right side so the tabs sit at the window's true centre -->
            <TitleBar.LeftHeader>
                <Border x:Name="LeftBalance" />
            </TitleBar.LeftHeader>
            <TitleBar.Content>
                <SelectorBar x:Name="Tabs" HorizontalAlignment="Center" SelectionChanged="OnTabChanged">
                    <SelectorBarItem Text="Focus" Tag="Focus" IsSelected="True" ToolTipService.ToolTip="Ctrl+1" />
                    <SelectorBarItem Text="Progress" Tag="Progress" ToolTipService.ToolTip="Ctrl+2" />
                    <SelectorBarItem Text="Habits" Tag="Habits" ToolTipService.ToolTip="Ctrl+3" />
                </SelectorBar>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <StackPanel x:Name="RightTools" Orientation="Horizontal" Spacing="4" Margin="0,0,8,0" VerticalAlignment="Center">
                    <Button x:Name="LiveTimer" Style="{StaticResource SoftButtonStyle}" Height="30" CornerRadius="15" Padding="12,0"
                            Background="{ThemeResource CardBrush}" BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1"
                            Visibility="Collapsed" Click="OnLiveTimer" ToolTipService.ToolTip="Back to your focus session">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse x:Name="LiveDot" Width="7" Height="7" Fill="{StaticResource SunriseBrush}" VerticalAlignment="Center" />
                            <TextBlock x:Name="LiveTime" Style="{StaticResource TitleSmallStyle}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PartnersButton" Style="{StaticResource ChromeButtonStyle}" Click="OnPartners"
                            ToolTipService.ToolTip="Partners (Ctrl+4)" AutomationProperties.Name="Partners">
                        <FontIcon Glyph="&#xE716;" FontSize="15" />
                    </Button>
                    <Button x:Name="SettingsButton" Style="{StaticResource ChromeButtonStyle}" Click="OnSettings"
                            ToolTipService.ToolTip="Settings (Ctrl+,)" AutomationProperties.Name="Settings">
                        <FontIcon Glyph="&#xE713;" FontSize="15" />
                    </Button>
                </StackPanel>
            </TitleBar.RightHeader>
        </TitleBar>
    </Grid>
</Window>
