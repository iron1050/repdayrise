<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Dayrise surfaces: round floating-bar buttons, the sunrise pill, glass panels over the sky and cards.
        Ports of HomeChrome.kt and Glass.kt. Each button template shares one hover/press overlay.
    -->

    <x:Double x:Key="BarHeight">52</x:Double>
    <x:Double x:Key="FloatingBarClearance">96</x:Double>
    <CornerRadius x:Key="CardRadius">20</CornerRadius>
    <CornerRadius x:Key="PanelRadius">28</CornerRadius>

    <!-- A button whose look is all Background/BorderBrush/CornerRadius, with a soft overlay on hover and press. -->
    <ControlTemplate x:Key="SoftButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" Background="Transparent">
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="Overlay" Background="{ThemeResource TextPrimaryBrush}" Opacity="0"
                    CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
            <ContentPresenter x:Name="Content"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" />
            <Grid.RenderTransform>
                <ScaleTransform x:Name="Scale" />
            </Grid.RenderTransform>
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Opacity" Value="0.08" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Overlay.Opacity" Value="0.14" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style x:Key="SoftButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource SoftButtonTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ManropeFontFamily}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
    </Style>

    <!-- Round end button of the floating bar (52 dp on Android). -->
    <Style x:Key="BarButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="Background" Value="{ThemeResource BarBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
    </Style>

    <!-- Centre pill of the floating bar. -->
    <Style x:Key="BarPillStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
        <Setter Property="Height" Value="52" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="Padding" Value="18,0,16,0" />
        <Setter Property="Background" Value="{ThemeResource BarBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource BarBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Small round translucent button on the sky (GlassCircleButton). -->
    <Style x:Key="GlassCircleButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Background" Value="#29FFFFFF" />
        <Setter Property="BorderBrush" Value="#38FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- The primary action: a warm gradient pill. -->
    <Style x:Key="SunrisePillButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
        <Setter Property="Height" Value="56" />
        <Setter Property="MinWidth" Value="168" />
        <Setter Property="CornerRadius" Value="28" />
        <Setter Property="Padding" Value="28,0" />
        <Setter Property="Background" Value="{StaticResource SunrisePillBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="17" />
    </Style>

    <!-- A secondary action on the sky: frosted outline pill. -->
    <Style x:Key="GlassPillButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
        <Setter Property="Height" Value="48" />
        <Setter Property="MinWidth" Value="48" />
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Padding" Value="18,0" />
        <Setter Property="Background" Value="#26FFFFFF" />
        <Setter Property="BorderBrush" Value="#3DFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
    </Style>

    <!-- Selectable chip (e.g. 25 / 50 / 90 min) on the sky. -->
    <ControlTemplate x:Key="ChipTemplate" TargetType="ToggleButton">
        <Grid x:Name="Root">
            <Border x:Name="Surface" Background="#1FFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <ContentPresenter x:Name="Content" Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                              Content="{TemplateBinding Content}" Foreground="White" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal" />
                    <VisualState x:Name="PointerOver">
                        <VisualState.Setters>
                            <Setter Target="Surface.Background" Value="#33FFFFFF" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <VisualState.Setters>
                            <Setter Target="Surface.Background" Value="#40FFFFFF" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Checked">
                        <VisualState.Setters>
                            <Setter Target="Surface.Background" Value="White" />
                            <Setter Target="Surface.BorderBrush" Value="White" />
                            <Setter Target="Content.Foreground" Value="#1A1B2E" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPointerOver">
                        <VisualState.Setters>
                            <Setter Target="Surface.Background" Value="#F2FFFFFF" />
                            <Setter Target="Surface.BorderBrush" Value="White" />
                            <Setter Target="Content.Foreground" Value="#1A1B2E" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedPressed">
                        <VisualState.Setters>
                            <Setter Target="Surface.Background" Value="#E6FFFFFF" />
                            <Setter Target="Content.Foreground" Value="#1A1B2E" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                    <VisualState x:Name="CheckedDisabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.4" />
                            <Setter Target="Surface.Background" Value="White" />
                            <Setter Target="Content.Foreground" Value="#1A1B2E" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style x:Key="SkyChipStyle" TargetType="ToggleButton">
        <Setter Property="Template" Value="{StaticResource ChipTemplate}" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="56" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="FontFamily" Value="{StaticResource ManropeFontFamily}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
    </Style>

    <!-- Frosted panel over the sky (frosted()/glassBorder in Glass.kt). -->
    <Style x:Key="GlassPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource GlassPanelBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource GlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource PanelRadius}" />
    </Style>

    <!-- A frosted strip on the sky itself: always light-on-dark. -->
    <Style x:Key="SkyGlassStyle" TargetType="Border">
        <Setter Property="Background" Value="#33000000" />
        <Setter Property="BorderBrush" Value="#33FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="22" />
    </Style>

    <!-- GlowCard: the standard card. -->
    <Style x:Key="DayriseCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!-- Page scaffolding shared by the plain (non-sky) pages: detail, edit, partners, settings. -->
    <x:Double x:Key="PageMaxWidth">820</x:Double>
    <!-- Clears the round buttons at the top and the floating bar at the bottom. -->
    <Thickness x:Key="PagePadding">24,64,24,120</Thickness>

    <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource DayriseCardStyle}" />

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource HeadlineLargeStyle}">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleMediumStyle}">
        <Setter Property="Margin" Value="2,28,0,10" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodySmallStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="StatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource HeadlineSmallStyle}" />

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="0" />
    </Style>
</ResourceDictionary>
