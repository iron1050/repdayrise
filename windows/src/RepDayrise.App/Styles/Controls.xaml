<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:RepDayrise.Services">

    <!--
        Quiet, native surfaces. Buttons ease their hover in and squash on a spring when pressed (Motion.Press);
        cards are Windows 11 layers with a hairline stroke. The sky gets its own small set: a white capsule for the
        one main action and plain text buttons for everything else.
    -->

    <CornerRadius x:Key="CardRadius">10</CornerRadius>

    <!-- A button drawn entirely from Background/BorderBrush/CornerRadius, with an eased hover/press tint. -->
    <ControlTemplate x:Key="SoftButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" Background="Transparent">
            <Border x:Name="Surface"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding CornerRadius}" />
            <Border x:Name="Overlay" Background="{TemplateBinding Foreground}" Opacity="0"
                    CornerRadius="{TemplateBinding CornerRadius}" IsHitTestVisible="False" />
            <ContentPresenter x:Name="Content"
                              Padding="{TemplateBinding Padding}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}" />
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="PointerOver">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0.07" Duration="0:0:0.12" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Pressed">
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetName="Overlay" Storyboard.TargetProperty="Opacity" To="0.12" Duration="0:0:0.06" />
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Disabled">
                        <VisualState.Setters>
                            <Setter Target="Root.Opacity" Value="0.4" />
                        </VisualState.Setters>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
    </ControlTemplate>

    <Style x:Key="SoftButtonStyle" TargetType="Button">
        <Setter Property="Template" Value="{StaticResource SoftButtonTemplate}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextPrimaryBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="services:Motion.Press" Value="True" />
    </Style>

    <!-- Title bar icon button (Partners, Settings, Back). -->
    <Style x:Key="ChromeButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="32" />
        <Setter Property="CornerRadius" Value="6" />
    </Style>

    <!-- On the sky: the single main action. White, quiet, unmistakable. -->
    <Style x:Key="SkyPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
        <Setter Property="Height" Value="52" />
        <Setter Property="MinWidth" Value="176" />
        <Setter Property="CornerRadius" Value="26" />
        <Setter Property="Padding" Value="32,0" />
        <Setter Property="Background" Value="White" />
        <Setter Property="Foreground" Value="#15161C" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <!-- On the sky: secondary actions read as text, tinted only on hover. -->
    <Style x:Key="SkyTextButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Foreground" Value="{StaticResource OnSkySecondaryBrush}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <!-- Cards: Windows 11 layer surfaces. -->
    <Style x:Key="DayriseCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource CardRadius}" />
        <Setter Property="Padding" Value="18" />
    </Style>
    <Style x:Key="CardStyle" TargetType="Border" BasedOn="{StaticResource DayriseCardStyle}" />

    <!-- An inset grouped list: one card, rows separated by hairlines. -->
    <Style x:Key="GroupedListStyle" TargetType="Border" BasedOn="{StaticResource DayriseCardStyle}">
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- A row inside a grouped list. -->
    <Style x:Key="ListRowButtonStyle" TargetType="Button" BasedOn="{StaticResource SoftButtonStyle}">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="services:Motion.Press" Value="False" />
    </Style>

    <!-- Page scaffolding for the plain pages (detail, edit, partners, settings). -->
    <x:Double x:Key="PageMaxWidth">760</x:Double>
    <Thickness x:Key="PagePadding">32,72,32,48</Thickness>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource HeadlineLargeStyle}">
        <Setter Property="Margin" Value="0,0,0,20" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleSmallStyle}">
        <Setter Property="Margin" Value="4,28,0,8" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource BodySmallStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextMutedBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="StatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource HeadlineSmallStyle}" />

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="0" />
    </Style>
</ResourceDictionary>
