<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Segoe UI Variable throughout: the Windows system face, hinted for the screen so text stays crisp at 100%
        scaling, with optical sizes. Display for large type, Text for UI, Small for captions. Its numerals are
        tabular, so a running timer never jitters.
    -->
    <FontFamily x:Key="DisplayFontFamily">Segoe UI Variable Display</FontFamily>
    <FontFamily x:Key="UiFontFamily">Segoe UI Variable Text</FontFamily>
    <FontFamily x:Key="SmallFontFamily">Segoe UI Variable Small</FontFamily>

    <!-- The one expressive piece of type: the timer. Light and very large, like a good clock face. -->
    <Style x:Key="TimerStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="Light" />
        <Setter Property="FontSize" Value="128" />
        <Setter Property="LineHeight" Value="128" />
        <Setter Property="LineStackingStrategy" Value="BlockLineHeight" />
        <Setter Property="CharacterSpacing" Value="-20" />
        <Setter Property="OpticalMarginAlignment" Value="TrimSideBearings" />
    </Style>

    <Style x:Key="DisplayLargeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="48" />
        <Setter Property="LineHeight" Value="56" />
    </Style>
    <Style x:Key="DisplayMediumStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="40" />
        <Setter Property="LineHeight" Value="48" />
    </Style>
    <!-- Large title: page headings -->
    <Style x:Key="HeadlineLargeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="32" />
        <Setter Property="LineHeight" Value="40" />
    </Style>
    <Style x:Key="HeadlineMediumStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="LineHeight" Value="32" />
    </Style>
    <Style x:Key="HeadlineSmallStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="LineHeight" Value="28" />
    </Style>
    <Style x:Key="TitleLargeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="LineHeight" Value="24" />
    </Style>
    <Style x:Key="TitleMediumStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="TitleSmallStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style x:Key="BodyLargeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LineHeight" Value="22" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BodyMediumStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="BodySmallStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SmallFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="LineHeight" Value="16" />
    </Style>
    <Style x:Key="LabelLargeStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource UiFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style x:Key="LabelMediumStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource SmallFontFamily}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="12" />
    </Style>
</ResourceDictionary>
