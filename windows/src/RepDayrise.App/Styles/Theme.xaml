<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Brand accent: Sunrise orange in place of the system accent, keeping every Fluent control style intact. -->
    <Color x:Key="SystemAccentColor">#F2803E</Color>
    <Color x:Key="SystemAccentColorLight1">#F59A62</Color>
    <Color x:Key="SystemAccentColorLight2">#F8B488</Color>
    <Color x:Key="SystemAccentColorLight3">#FBCFB0</Color>
    <Color x:Key="SystemAccentColorDark1">#C9581F</Color>
    <Color x:Key="SystemAccentColorDark2">#A8461A</Color>
    <Color x:Key="SystemAccentColorDark3">#843614</Color>

    <x:Double x:Key="PageMaxWidth">960</x:Double>
    <!-- Clears the round buttons at the top and the floating bar at the bottom. -->
    <Thickness x:Key="PagePadding">36,64,36,110</Thickness>

    <!-- A Fluent card: the surface used by Settings and the Windows 11 inbox apps. -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <Style x:Key="PageTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource TitleTextBlockStyle}">
        <Setter Property="Margin" Value="0,0,0,16" />
    </Style>

    <Style x:Key="SectionHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
        <Setter Property="Margin" Value="2,24,0,8" />
    </Style>

    <Style x:Key="SecondaryTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="StatValueStyle" TargetType="TextBlock" BasedOn="{StaticResource SubtitleTextBlockStyle}" />

    <Style x:Key="IconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
        <Setter Property="Padding" Value="8" />
        <Setter Property="MinWidth" Value="0" />
    </Style>
</ResourceDictionary>
