<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Port of the Android app's ui/theme/Color.kt and Theme.kt colour schemes. -->

    <!-- Brand -->
    <Color x:Key="SunriseColor">#F2803E</Color>
    <Color x:Key="SunriseDeepColor">#D9642A</Color>
    <Color x:Key="SunriseSoftColor">#FFD9BF</Color>
    <Color x:Key="GoldColor">#FFC14D</Color>
    <Color x:Key="IndigoColor">#3A3F8F</Color>
    <Color x:Key="FlameColor">#FF6B3D</Color>

    <!-- The accent every Fluent control uses -->
    <Color x:Key="SystemAccentColor">#F2803E</Color>
    <Color x:Key="SystemAccentColorLight1">#F59A62</Color>
    <Color x:Key="SystemAccentColorLight2">#F8B488</Color>
    <Color x:Key="SystemAccentColorLight3">#FBCFB0</Color>
    <Color x:Key="SystemAccentColorDark1">#C9581F</Color>
    <Color x:Key="SystemAccentColorDark2">#A8461A</Color>
    <Color x:Key="SystemAccentColorDark3">#843614</Color>

    <SolidColorBrush x:Key="SunriseBrush" Color="#F2803E" />
    <SolidColorBrush x:Key="FlameBrush" Color="#FF6B3D" />
    <SolidColorBrush x:Key="OnSkyBrush" Color="White" />
    <SolidColorBrush x:Key="OnSkyMutedBrush" Color="#9EFFFFFF" />

    <!-- Primary buttons: Dayrise's warm sunrise pill -->
    <LinearGradientBrush x:Key="SunrisePillBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Offset="0" Color="#FF9A4D" />
        <GradientStop Offset="0.5" Color="#F2803E" />
        <GradientStop Offset="1" Color="#E85D8A" />
    </LinearGradientBrush>

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#050509" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#111219" />
            <SolidColorBrush x:Key="SurfaceHighBrush" Color="#1A1C27" />
            <SolidColorBrush x:Key="SurfaceHighestBrush" Color="#242736" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F1F8" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#A9ACC7" />
            <SolidColorBrush x:Key="OutlineBrush" Color="#282B3D" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#FFB067" />
            <!-- Floating bar and its round buttons -->
            <SolidColorBrush x:Key="BarBrush" Color="#EB1C2030" />
            <SolidColorBrush x:Key="BarSelectedBrush" Color="#FF3A3D4A" />
            <SolidColorBrush x:Key="BarBorderBrush" Color="#14FFFFFF" />
            <!-- Glass panels over the sky -->
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#1FFFFFFF" />
            <AcrylicBrush x:Key="GlassPanelBrush" TintColor="#050509" TintOpacity="0.72" TintLuminosityOpacity="0.85" FallbackColor="#E6111219" />
            <SolidColorBrush x:Key="CardBrush" Color="#111219" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#14FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F7F4EE" />
            <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceHighBrush" Color="#F1EDE5" />
            <SolidColorBrush x:Key="SurfaceHighestBrush" Color="#E9E4DA" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1A1B2E" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#5E6078" />
            <SolidColorBrush x:Key="OutlineBrush" Color="#E3DFD6" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#F2803E" />
            <SolidColorBrush x:Key="BarBrush" Color="#F5E9E4DA" />
            <SolidColorBrush x:Key="BarSelectedBrush" Color="#FFC9C3B8" />
            <SolidColorBrush x:Key="BarBorderBrush" Color="#14000000" />
            <SolidColorBrush x:Key="GlassBorderBrush" Color="#8CFFFFFF" />
            <AcrylicBrush x:Key="GlassPanelBrush" TintColor="#F7F4EE" TintOpacity="0.72" TintLuminosityOpacity="0.85" FallbackColor="#E6F7F4EE" />
            <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#0F000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
