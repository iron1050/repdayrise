<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Native Windows 11 surfaces (Mica behind everything, layer fills and hairline strokes on top) with one brand
        accent. The sky is the only place colour gets loud.
    -->

    <Color x:Key="SunriseColor">#F2803E</Color>
    <Color x:Key="FlameColor">#FF6B3D</Color>

    <!-- The accent every Fluent control uses -->
    <Color x:Key="SystemAccentColor">#F2803E</Color>
    <Color x:Key="SystemAccentColorLight1">#F59A62</Color>
    <Color x:Key="SystemAccentColorLight2">#F8B488</Color>
    <Color x:Key="SystemAccentColorLight3">#FBCFB0</Color>
    <Color x:Key="SystemAccentColorDark1">#C9581F</Color>
    <Color x:Key="SystemAccentColorDark2">#A8461A</Color>
    <Color x:Key="SystemAccentColorDark3">#843614</Color>

    <SolidColorBrush x:Key="SunriseBrush" Color="#F2803E" />
    <SolidColorBrush x:Key="FlameBrush" Color="#FF6B3D" />

    <!-- On the sky: solid white for anything read, a clearly secondary but still solid tone for the rest. -->
    <SolidColorBrush x:Key="OnSkyBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="OnSkySecondaryBrush" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="SkyControlBrush" Color="#2E0B0E1F" />
    <SolidColorBrush x:Key="SkyControlHoverBrush" Color="#470B0E1F" />
    <SolidColorBrush x:Key="SkyHairlineBrush" Color="#33FFFFFF" />

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
            <!-- Pages are transparent so Mica shows through, as in Windows' own apps. -->
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#A9AAB2" />
            <SolidColorBrush x:Key="OutlineBrush" Color="#2E2F36" />
            <SolidColorBrush x:Key="DividerBrush" Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#FF9A5C" />
            <SolidColorBrush x:Key="CardBrush" Color="#0DFFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#19000000" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="SurfaceHighestBrush" Color="#14FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AppBackgroundBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B1B1F" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#5D5E66" />
            <SolidColorBrush x:Key="OutlineBrush" Color="#DEDEE3" />
            <SolidColorBrush x:Key="DividerBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="PrimaryBrush" Color="#D9642A" />
            <SolidColorBrush x:Key="CardBrush" Color="#B3FFFFFF" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#0F000000" />
            <SolidColorBrush x:Key="CardHoverBrush" Color="#08000000" />
            <SolidColorBrush x:Key="SurfaceHighestBrush" Color="#0A000000" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
