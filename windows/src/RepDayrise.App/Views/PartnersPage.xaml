<Page
    x:Class="RepDayrise.Views.PartnersPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
            <Grid Margin="0,0,0,8">
                <TextBlock Text="Partners" Style="{StaticResource TitleTextBlockStyle}" />
                <Button x:Name="RefreshButton" HorizontalAlignment="Right" Click="OnRefresh" ToolTipService.ToolTip="Refresh" AutomationProperties.Name="Refresh">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE72C;" FontSize="14" />
                        <TextBlock Text="Refresh" />
                    </StackPanel>
                </Button>
            </Grid>
            <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap" Margin="0,0,0,12"
                       Text="Share your habit list with people who keep you on track, and follow theirs. No accounts: an invite code is all it takes. Notes, reminders and groups never leave this PC." />

            <InfoBar x:Name="ErrorBar" Severity="Error" IsOpen="False" Title="Something went wrong" />
            <InfoBar x:Name="ServerBar" Severity="Warning" IsOpen="False" IsClosable="False"
                     Title="No server yet" Message="Sharing needs the address of a RepDayrise sharing server.">
                <InfoBar.ActionButton>
                    <Button Content="Add server address" Click="OnEditServer" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- Your list -->
            <TextBlock Text="Your list" Style="{StaticResource SectionHeaderStyle}" Margin="2,8,0,8" />
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <StackPanel x:Name="NotSharingPanel" Spacing="12">
                        <TextBlock TextWrapping="Wrap"
                                   Text="Publish your list to get an invite code. Anyone you give it to can see your habits and progress, read-only." />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBox x:Name="ShareNameBox" Header="Your name, as partners will see it" MinWidth="260" MaxLength="40" TextChanged="OnShareNameChanged" />
                            <Button x:Name="StartSharingButton" Content="Start sharing" Style="{StaticResource AccentButtonStyle}"
                                    VerticalAlignment="Bottom" Click="OnStartSharing" IsEnabled="False" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel x:Name="SharingPanel" Spacing="14" Visibility="Collapsed">
                        <Grid ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Invite code" Style="{StaticResource SecondaryTextStyle}" />
                                <TextBlock x:Name="CodeText" FontFamily="Cascadia Mono, Consolas" FontSize="28" IsTextSelectionEnabled="True" />
                                <TextBlock x:Name="SyncText" Style="{StaticResource SecondaryTextStyle}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center">
                                <Button Click="OnCopyInvite" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE71B;" FontSize="14" />
                                        <TextBlock Text="Copy invite" />
                                    </StackPanel>
                                </Button>
                                <Button Click="OnRotateCode" HorizontalAlignment="Stretch" ToolTipService.ToolTip="The old code stops working. Current partners stay.">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE895;" FontSize="14" />
                                        <TextBlock Text="New code" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                        <InfoBar x:Name="PushErrorBar" Severity="Warning" IsOpen="False" IsClosable="False" Title="Not up to date" />

                        <TextBlock Text="Following you" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock x:Name="NoPartnersText" Style="{StaticResource SecondaryTextStyle}" Text="Nobody yet. Send someone your invite." />
                        <StackPanel x:Name="PartnerList" Spacing="6" />

                        <TextBlock Text="What partners see" Style="{StaticResource BodyStrongTextBlockStyle}" Margin="0,6,0,0" />
                        <StackPanel x:Name="SharedHabitList" Spacing="2" />

                        <Button Content="Stop sharing" Click="OnStopSharing" Margin="0,6,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Following -->
            <Grid Margin="2,24,0,8">
                <TextBlock Text="Lists you follow" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Click="OnFollow">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon Glyph="&#xE8FA;" FontSize="14" />
                        <TextBlock Text="Follow someone" />
                    </StackPanel>
                </Button>
            </Grid>
            <Border x:Name="NoFollowingCard" Style="{StaticResource CardStyle}">
                <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                           Text="When a partner sends you their invite code, follow them here to see their day." />
            </Border>
            <StackPanel x:Name="FollowingList" Spacing="6" />

            <!-- Server -->
            <TextBlock Text="Server" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock x:Name="ServerText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                   Text="New shares and follows use this address. Lists you already share or follow keep their own." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Change…" VerticalAlignment="Center" Click="OnEditServer" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
