<Page
    x:Class="RepDayrise.Views.HistoryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RepDayrise.Controls"
    xmlns:views="using:RepDayrise.Views">

    <Page.Resources>
        <DataTemplate x:Key="HabitSummaryTemplate" x:DataType="views:HabitSummary">
            <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="12,10" Margin="0,0,0,6"
                    Click="OnOpenHabit" Tag="{x:Bind Id}" AutomationProperties.Name="{x:Bind Name}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="160" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="36" Height="36">
                        <Ellipse Fill="{x:Bind Brush}" />
                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="White" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{x:Bind Detail}" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Text="{x:Bind MonthText}" Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Right" />
                        <ProgressBar Value="{x:Bind MonthPercent}" Foreground="{x:Bind Brush}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
            <TextBlock Text="History" Style="{StaticResource PageTitleStyle}" />

            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="SunrisesText" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Text="Sunrises this year" Style="{StaticResource SecondaryTextStyle}" ToolTipService.ToolTip="Days where every due habit was finished" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="ActiveDaysText" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Text="Days with progress" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock x:Name="WeekText" Style="{StaticResource StatValueStyle}" />
                        <TextBlock Text="This week" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Border>
            </Grid>

            <TextBlock Text="The past year" Style="{StaticResource SectionHeaderStyle}" />
            <Border Style="{StaticResource CardStyle}">
                <controls:ContributionGraph x:Name="YearGraph" />
            </Border>

            <TextBlock Text="Habits" Style="{StaticResource SectionHeaderStyle}" />
            <TextBlock x:Name="NoHabitsText" Text="No habits yet." Style="{StaticResource SecondaryTextStyle}" Visibility="Collapsed" />
            <ItemsRepeater x:Name="HabitList" ItemTemplate="{StaticResource HabitSummaryTemplate}" />

            <Expander x:Name="ArchivedExpander" Header="Archived" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Margin="0,18,0,0">
                <ItemsRepeater x:Name="ArchivedList" ItemTemplate="{StaticResource HabitSummaryTemplate}" />
            </Expander>
        </StackPanel>
    </ScrollViewer>
</Page>
