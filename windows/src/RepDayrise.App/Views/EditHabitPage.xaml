<Page
    x:Class="RepDayrise.Views.EditHabitPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:services="using:RepDayrise.Services">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer>
            <StackPanel MaxWidth="760" Padding="{StaticResource PagePadding}" Spacing="4">
                <!-- Header with a live preview of the badge -->
                <Grid ColumnSpacing="16" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="56" Height="56">
                        <Ellipse x:Name="PreviewCircle" />
                        <FontIcon x:Name="PreviewIcon" FontSize="26" Foreground="White" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Style="{StaticResource TitleTextBlockStyle}" Text="New habit" />
                        <TextBlock x:Name="PreviewSubtitle" Style="{StaticResource SecondaryTextStyle}" />
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBox x:Name="NameBox" Header="Name" PlaceholderText="e.g. Read 20 pages" MaxLength="60" TextChanged="OnChanged" />
                        <TextBox x:Name="NoteBox" Header="Note (stays on this device)" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxLength="500" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Look" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Colour" Style="{StaticResource SecondaryTextStyle}" />
                        <GridView x:Name="ColorGrid" SelectionMode="Single" SelectionChanged="OnChanged" IsItemClickEnabled="False">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="services:ColorChoice">
                                    <Ellipse Width="28" Height="28" Margin="4" Fill="{x:Bind Brush}" />
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                        <TextBlock Text="Icon" Style="{StaticResource SecondaryTextStyle}" />
                        <GridView x:Name="IconGrid" SelectionMode="Single" SelectionChanged="OnChanged" MaxHeight="220">
                            <GridView.ItemTemplate>
                                <DataTemplate x:DataType="services:IconChoice">
                                    <Grid Width="40" Height="40" AutomationProperties.Name="{x:Bind Key}">
                                        <FontIcon Glyph="{x:Bind Glyph}" FontSize="18" />
                                    </Grid>
                                </DataTemplate>
                            </GridView.ItemTemplate>
                        </GridView>
                    </StackPanel>
                </Border>

                <TextBlock Text="Goal" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <RadioButtons x:Name="TypeButtons" Header="Kind" MaxColumns="3" SelectionChanged="OnChanged">
                            <x:String>Check off</x:String>
                            <x:String>Count</x:String>
                            <x:String>Timer</x:String>
                        </RadioButtons>
                        <StackPanel x:Name="GoalPanel" Orientation="Horizontal" Spacing="12">
                            <NumberBox x:Name="GoalBox" Header="Goal" Minimum="0.1" Maximum="100000" SmallChange="1" LargeChange="10"
                                       SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" MinWidth="160" ValueChanged="OnGoalChanged" />
                            <TextBox x:Name="UnitBox" Header="Unit" PlaceholderText="glasses" MinWidth="160" MaxLength="20" TextChanged="OnChanged" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="Schedule" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <RadioButtons x:Name="ScheduleButtons" Header="Repeat" MaxColumns="3" SelectionChanged="OnChanged">
                            <x:String>Daily</x:String>
                            <x:String>Weekly</x:String>
                            <x:String>Monthly</x:String>
                        </RadioButtons>
                        <StackPanel x:Name="DaysPanel" Spacing="8">
                            <TextBlock Text="On these days" Style="{StaticResource SecondaryTextStyle}" />
                            <StackPanel x:Name="DayToggles" Orientation="Horizontal" Spacing="6" />
                        </StackPanel>
                        <NumberBox x:Name="TimesBox" Header="Times per week" Minimum="1" Maximum="31" SmallChange="1"
                                   SpinButtonPlacementMode="Inline" ValidationMode="InvalidInputOverwritten" HorizontalAlignment="Left" MinWidth="160"
                                   ValueChanged="OnGoalChanged" />
                        <CalendarDatePicker x:Name="StartPicker" Header="Starts" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Organise" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <ComboBox x:Name="GroupBox" Header="Group" MinWidth="220" DisplayMemberPath="Name" />
                            <Button Content="New group…" VerticalAlignment="Bottom" Click="OnNewGroup" />
                        </StackPanel>
                        <ToggleSwitch x:Name="ShareSwitch" Header="Share with partners" OnContent="Partners can see this habit" OffContent="Hidden from partners" Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <TextBlock Text="Reminders" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel Spacing="8">
                        <StackPanel x:Name="ReminderList" Spacing="8" />
                        <Button Click="OnAddReminder">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="Add reminder" />
                            </StackPanel>
                        </Button>
                        <TextBlock Style="{StaticResource SecondaryTextStyle}" TextWrapping="Wrap"
                                   Text="Reminders arrive as Windows notifications, even when RepDayrise is closed." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Footer -->
        <Border Grid.Row="1" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0"
                Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="24,12">
            <Grid MaxWidth="760">
                <Button x:Name="DeleteButton" Content="Delete" Click="OnDelete" Visibility="Collapsed" />
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="Cancel" Click="OnCancel" />
                    <Button x:Name="SaveButton" Content="Save" Style="{StaticResource AccentButtonStyle}" Click="OnSave" MinWidth="96" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Page>
