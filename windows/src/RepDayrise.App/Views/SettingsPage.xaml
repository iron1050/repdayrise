<Page
    x:Class="RepDayrise.Views.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RepDayrise.Controls"
    xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
    Background="{ThemeResource AppBackgroundBrush}">

    <!-- Native Windows 11 settings cards, grouped the way Windows Settings groups things. -->
    <Page.Resources>
        <x:Double x:Key="SettingsCardSpacing">4</x:Double>
        <!-- Switches without On/Off labels, flush with the right edge like Windows Settings -->
        <x:Double x:Key="ToggleSwitchPreContentMargin">0</x:Double>
        <x:Double x:Key="ToggleSwitchPostContentMargin">0</x:Double>
        <Style x:Key="CompactSwitch" TargetType="ToggleSwitch">
            <Setter Property="OnContent" Value="" />
            <Setter Property="OffContent" Value="" />
            <Setter Property="MinWidth" Value="0" />
        </Style>
    </Page.Resources>

    <ScrollViewer>
      <controls:ViewportPanel>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}" Spacing="{StaticResource SettingsCardSpacing}">
            <TextBlock Text="Settings" Style="{StaticResource PageTitleStyle}" />

            <TextBlock Text="Focus" Style="{StaticResource SectionHeaderStyle}" Margin="4,4,0,8" />
            <toolkit:SettingsExpander Header="Breaks" Description="Short breaks between sessions and a longer one every few"
                                      IsExpanded="True">
                <toolkit:SettingsExpander.HeaderIcon>
                    <FontIcon Glyph="&#xEC32;" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Header="Short break">
                        <NumberBox x:Name="ShortBreakBox" Minimum="1" Maximum="120" SpinButtonPlacementMode="Compact" Width="120"
                                   ValueChanged="OnFocusNumber" AutomationProperties.Name="Short break, minutes" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Long break">
                        <NumberBox x:Name="LongBreakBox" Minimum="1" Maximum="120" SpinButtonPlacementMode="Compact" Width="120"
                                   ValueChanged="OnFocusNumber" AutomationProperties.Name="Long break, minutes" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Sessions before a long break">
                        <NumberBox x:Name="LongEveryBox" Minimum="1" Maximum="8" SpinButtonPlacementMode="Compact" Width="120"
                                   ValueChanged="OnFocusNumber" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Start breaks automatically">
                        <ToggleSwitch x:Name="AutoBreakSwitch" Style="{StaticResource CompactSwitch}" Toggled="OnFocusToggle" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Start the next session automatically">
                        <ToggleSwitch x:Name="AutoFocusSwitch" Style="{StaticResource CompactSwitch}" Toggled="OnFocusToggle" />
                    </toolkit:SettingsCard>
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>

            <toolkit:SettingsCard Header="Daily focus goal" Description="Focus this long in a day to keep your streak going (minutes)">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE945;" />
                </toolkit:SettingsCard.HeaderIcon>
                <NumberBox x:Name="DailyGoalBox" Minimum="5" Maximum="720" SmallChange="5" LargeChange="30" SpinButtonPlacementMode="Compact"
                           Width="120" ValueChanged="OnFocusNumber" AutomationProperties.Name="Daily focus goal, minutes" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Header="Count sessions you end early" Description="Anything a minute or longer still counts toward your habit">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE916;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="PartialSwitch" Style="{StaticResource CompactSwitch}" Toggled="OnFocusToggle" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Header="Hold habit reminders while focusing" Description="They arrive just after the session ends instead">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE7ED;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="QuietSwitch" Style="{StaticResource CompactSwitch}" Toggled="OnFocusToggle" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Header="Chime when Do not disturb is on" Description="Windows mutes notifications in Focus, so play a soft sound when a session ends">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE767;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="SoundSwitch" Style="{StaticResource CompactSwitch}" Toggled="OnFocusToggle" />
            </toolkit:SettingsCard>

            <toolkit:SettingsCard Header="Do not disturb" Description="Turn on Windows Focus to silence other apps while you work"
                                  IsClickEnabled="True" Click="OnOpenFocusSettings" ActionIcon="{x:Null}">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE708;" />
                </toolkit:SettingsCard.HeaderIcon>
                <toolkit:SettingsCard.ActionIconToolTip>Open Windows settings</toolkit:SettingsCard.ActionIconToolTip>
            </toolkit:SettingsCard>

            <TextBlock Text="Habits" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard Header="Week starts on">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE787;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="WeekStartBox" MinWidth="140" SelectionChanged="OnWeekStartChanged">
                    <x:String>Monday</x:String>
                    <x:String>Sunday</x:String>
                </ComboBox>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Move finished habits to the bottom">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE8CB;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="CompletedSwitch" Style="{StaticResource CompactSwitch}" Toggled="OnCompletedToggled" />
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Notifications" Description="Reminders are set on each habit. Windows decides whether they appear."
                                  IsClickEnabled="True" Click="OnOpenNotifications">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEA8F;" />
                </toolkit:SettingsCard.HeaderIcon>
            </toolkit:SettingsCard>

            <TextBlock Text="Appearance" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsCard Header="Theme">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xE790;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ComboBox x:Name="ThemeButtons" MinWidth="140" SelectionChanged="OnThemeChanged">
                    <x:String>Use system setting</x:String>
                    <x:String>Light</x:String>
                    <x:String>Dark</x:String>
                </ComboBox>
            </toolkit:SettingsCard>
            <toolkit:SettingsCard Header="Save power" Description="Animate the sky more slowly">
                <toolkit:SettingsCard.HeaderIcon>
                    <FontIcon Glyph="&#xEC48;" />
                </toolkit:SettingsCard.HeaderIcon>
                <ToggleSwitch x:Name="EcoSwitch" Style="{StaticResource CompactSwitch}" Toggled="OnEcoToggled" />
            </toolkit:SettingsCard>

            <TextBlock Text="About" Style="{StaticResource SectionHeaderStyle}" />
            <toolkit:SettingsExpander Header="RepDayrise" x:Name="AboutCard">
                <toolkit:SettingsExpander.HeaderIcon>
                    <BitmapIcon UriSource="ms-appx:///Assets/Square44x44Logo.targetsize-48.png" ShowAsMonochrome="False" />
                </toolkit:SettingsExpander.HeaderIcon>
                <toolkit:SettingsExpander.Items>
                    <toolkit:SettingsCard Header="Your data" Description="Habits and sessions are stored only on this PC. Uninstalling RepDayrise from Start removes them.">
                        <Button Content="Open data folder" Click="OnOpenDataFolder" />
                    </toolkit:SettingsCard>
                    <toolkit:SettingsCard Header="Credits" Description="Inspired by the Dayrise habit app. An independent reimplementation made for learning, not affiliated with it." />
                </toolkit:SettingsExpander.Items>
            </toolkit:SettingsExpander>
        </StackPanel>
      </controls:ViewportPanel>
    </ScrollViewer>
</Page>
