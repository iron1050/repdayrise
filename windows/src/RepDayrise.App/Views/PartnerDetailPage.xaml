<Page
    x:Class="RepDayrise.Views.PartnerDetailPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RepDayrise.Controls">

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
            <Grid Margin="0,0,0,16" ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <PersonPicture x:Name="Avatar" Width="48" Height="48" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="NameText" Style="{StaticResource TitleTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="UpdatedText" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Unfollow" Click="OnUnfollow" VerticalAlignment="Center" />
            </Grid>

            <InfoBar x:Name="EndedBar" Severity="Informational" IsOpen="False" IsClosable="False"
                     Title="No longer shared" Message="They stopped sharing or removed you. This is the last update you received." />

            <StackPanel x:Name="ContentPanel">
                <Grid Height="190" Margin="0,8,0,0">
                    <controls:SunriseSky x:Name="Sky" />
                    <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,14">
                        <TextBlock x:Name="ProgressText" Foreground="White" Style="{StaticResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="ProgressDetail" Foreground="White" Opacity="0.85" Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="Habits" Style="{StaticResource SectionHeaderStyle}" />
                <StackPanel x:Name="HabitList" Spacing="6" />

                <TextBlock Text="The past year" Style="{StaticResource SectionHeaderStyle}" />
                <Border Style="{StaticResource CardStyle}">
                    <controls:ContributionGraph x:Name="YearGraph" />
                </Border>
            </StackPanel>

            <Border x:Name="WaitingCard" Style="{StaticResource CardStyle}" Visibility="Collapsed" Margin="0,8,0,0">
                <TextBlock Text="Nothing yet. Their list appears here after their app publishes it." TextWrapping="Wrap"
                           Style="{StaticResource SecondaryTextStyle}" />
            </Border>
        </StackPanel>
    </ScrollViewer>
</Page>
