<Page
    x:Class="RepDayrise.Views.TodayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RepDayrise.Controls"
    xmlns:vm="using:RepDayrise.ViewModels"
    NavigationCacheMode="Required">

    <Page.Resources>
        <!-- One habit card. The left part opens the habit; the right part logs progress. -->
        <DataTemplate x:Key="HabitRowTemplate" x:DataType="vm:HabitRowViewModel">
            <Grid
                Margin="0,0,0,6"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Set value…" Click="{x:Bind SetExact}" Visibility="{x:Bind IsMeasurable, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EF;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Edit" Click="{x:Bind Edit}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Archive" Click="{x:Bind Archive}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Delete" Click="{x:Bind Delete}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button
                    Padding="12,10"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="{x:Bind Open}"
                    AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid Width="40" Height="40">
                            <Ellipse Fill="{x:Bind ColorBrush, Mode=OneWay}" />
                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="18" Foreground="White" />
                        </Grid>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Check -->
                <Button
                    Grid.Column="1"
                    Width="40" Height="40" Margin="0,0,14,0" Padding="0"
                    CornerRadius="20"
                    Visibility="{x:Bind IsCheck, Mode=OneWay}"
                    Background="{x:Bind CheckBackground, Mode=OneWay}"
                    BorderBrush="{x:Bind ColorBrush, Mode=OneWay}"
                    BorderThickness="2"
                    Click="{x:Bind ToggleCheck}"
                    AutomationProperties.Name="{x:Bind CheckLabel, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind CheckLabel, Mode=OneWay}">
                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="White" Opacity="{x:Bind CheckIconOpacity, Mode=OneWay}" />
                </Button>

                <!-- Count -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0" Visibility="{x:Bind IsCount, Mode=OneWay}">
                    <Button Style="{StaticResource IconButtonStyle}" Background="Transparent" BorderThickness="0"
                            Click="{x:Bind Decrement}" AutomationProperties.Name="Subtract one" ToolTipService.ToolTip="Subtract one">
                        <FontIcon Glyph="&#xE738;" FontSize="12" />
                    </Button>
                    <Grid Width="44" Height="44">
                        <ProgressRing IsIndeterminate="False" Value="{x:Bind Percent, Mode=OneWay}" Width="44" Height="44"
                                      Foreground="{x:Bind ColorBrush, Mode=OneWay}" Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}" />
                        <Button Width="34" Height="34" Padding="0" CornerRadius="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Click="{x:Bind Increment}" AutomationProperties.Name="Add one" ToolTipService.ToolTip="Add one">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Timer -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,0,10,0" Visibility="{x:Bind IsTimer, Mode=OneWay}">
                    <TextBlock Text="{x:Bind TimerText, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,4,0"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Button Style="{StaticResource IconButtonStyle}" Background="Transparent" BorderThickness="0"
                            Visibility="{x:Bind TimerActive, Mode=OneWay}"
                            Click="{x:Bind FinishTimer}" AutomationProperties.Name="Finish and log" ToolTipService.ToolTip="Finish and log">
                        <FontIcon Glyph="&#xE73E;" FontSize="14" />
                    </Button>
                    <Grid Width="44" Height="44">
                        <ProgressRing IsIndeterminate="False" Value="{x:Bind Percent, Mode=OneWay}" Width="44" Height="44"
                                      Foreground="{x:Bind ColorBrush, Mode=OneWay}" Background="{ThemeResource ControlStrongStrokeColorDisabledBrush}" />
                        <Button Width="34" Height="34" Padding="0" CornerRadius="17" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="Transparent" BorderThickness="0"
                                Click="{x:Bind ToggleTimer}" AutomationProperties.Name="Start or pause timer" ToolTipService.ToolTip="Start or pause">
                            <FontIcon Glyph="{x:Bind TimerGlyph, Mode=OneWay}" FontSize="14" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SectionTemplate" x:DataType="vm:HabitSectionViewModel">
            <StackPanel>
                <Button
                    Visibility="{x:Bind HasHeader}"
                    Margin="0,10,0,6" Padding="4,4,10,4"
                    Background="Transparent" BorderThickness="0"
                    Click="{x:Bind ToggleCollapsed}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="12" />
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource SecondaryTextStyle}" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <ItemsRepeater
                    ItemsSource="{x:Bind Rows}"
                    ItemTemplate="{StaticResource HabitRowTemplate}"
                    Visibility="{x:Bind IsExpanded, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
            <Grid Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText" Style="{StaticResource TitleTextBlockStyle}" Text="Today" />
                    <TextBlock x:Name="DateText" Style="{StaticResource SecondaryTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button x:Name="BackToTodayButton" Content="Today" Click="OnBackToToday" Visibility="Collapsed" />
                    <Button Style="{StaticResource AccentButtonStyle}" Click="OnNewHabit">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                            <TextBlock Text="New habit" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- The sunrise -->
            <Grid Height="230">
                <controls:SunriseSky x:Name="Sky" />
                <StackPanel VerticalAlignment="Bottom" Margin="20,0,20,16">
                    <TextBlock x:Name="ProgressText" Foreground="White" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock x:Name="ProgressDetail" Foreground="White" Opacity="0.85" Style="{StaticResource CaptionTextBlockStyle}" />
                </StackPanel>
            </Grid>

            <!-- Week strip -->
            <Grid x:Name="WeekStrip" Margin="0,12,0,8" ColumnSpacing="6" />

            <!-- Empty state -->
            <Border x:Name="EmptyState" Style="{StaticResource CardStyle}" Margin="0,12,0,0" Padding="28" Visibility="Collapsed">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <FontIcon Glyph="&#xED39;" FontSize="40" Foreground="{ThemeResource AccentFillColorDefaultBrush}" />
                    <TextBlock x:Name="EmptyTitle" Text="Nothing to do today" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyBody" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420"
                               Style="{StaticResource SecondaryTextStyle}" HorizontalAlignment="Center" />
                    <Button x:Name="EmptyAddButton" Content="Create your first habit" Style="{StaticResource AccentButtonStyle}"
                            HorizontalAlignment="Center" Click="OnNewHabit" />
                </StackPanel>
            </Border>

            <ItemsRepeater x:Name="Sections" ItemTemplate="{StaticResource SectionTemplate}" />
        </StackPanel>
    </ScrollViewer>
</Page>
