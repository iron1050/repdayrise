<Page
    x:Class="RepDayrise.Views.FocusPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RepDayrise.Controls"
    xmlns:sky="using:RepDayrise.Controls.Sky"
    Background="#05060F"
    RequestedTheme="Dark">

    <!--
        Focus. The window is the sky; the sun climbs through each focus session, so the sky is the progress.
        One large, light timer, one white action, and everything else as quiet text.
    -->
    <Page.Resources>
        <!-- Custom length -->
        <Flyout x:Key="CustomFlyout" Placement="Bottom">
            <StackPanel Spacing="12" Width="220">
                <NumberBox x:Name="CustomMinutes" Header="Minutes of focus" Minimum="1" Maximum="600" SmallChange="5" LargeChange="15"
                           SpinButtonPlacementMode="Inline" />
                <Button Content="Use this length" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Click="OnCustomApply" />
            </StackPanel>
        </Flyout>
    </Page.Resources>

    <Grid x:Name="Root">
        <sky:SkyCanvas x:Name="Sky" HillFraction="0.2" />

        <!-- Do not disturb: status and shortcut -->
        <Button x:Name="QuietButton" Style="{StaticResource SkyTextButtonStyle}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,58,20,0" Click="OnQuiet">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon x:Name="QuietIcon" Glyph="&#xE708;" FontSize="14" />
                <TextBlock x:Name="QuietText" Text="Do not disturb" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <StackPanel x:Name="Centre" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,24,0,72">
            <!-- What this session counts toward -->
            <Button x:Name="HabitButton" Style="{StaticResource SkyTextButtonStyle}" HorizontalAlignment="Center" FontSize="15">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="HabitDot" Width="8" Height="8" VerticalAlignment="Center" />
                    <TextBlock x:Name="HabitLabel" Text="Choose a habit" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                    <FontIcon Glyph="&#xE70D;" FontSize="10" Margin="0,2,0,0" />
                </StackPanel>
                <Button.Flyout>
                    <MenuFlyout x:Name="HabitMenu" Placement="Bottom" />
                </Button.Flyout>
            </Button>

            <TextBlock x:Name="Countdown" Text="25:00" Style="{StaticResource TimerStyle}" Foreground="{StaticResource OnSkyBrush}"
                       HorizontalAlignment="Center" Margin="0,6,0,0" AutomationProperties.LiveSetting="Off" />

            <TextBlock x:Name="Status" Text="25 minutes" Style="{StaticResource BodyLargeStyle}" Foreground="{StaticResource OnSkySecondaryBrush}"
                       HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0" />

            <controls:SkySegmented x:Name="LengthPicker" Margin="0,30,0,0" />

            <Button x:Name="PrimaryButton" Style="{StaticResource SkyPrimaryButtonStyle}" HorizontalAlignment="Center" Margin="0,30,0,0"
                    Click="OnPrimary" AutomationProperties.Name="Start focus">
                <TextBlock x:Name="PrimaryLabel" Text="Start focus" />
            </Button>

            <StackPanel x:Name="Secondary" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4" Margin="0,12,0,0">
                <Button x:Name="BreaksButton" Style="{StaticResource SkyTextButtonStyle}" Click="OnBreaks"
                        ToolTipService.ToolTip="Short breaks between sessions, and a longer one every few">
                    <TextBlock x:Name="BreaksLabel" Text="Breaks on" />
                </Button>
                <Button x:Name="SkipButton" Style="{StaticResource SkyTextButtonStyle}" Click="OnSkip">
                    <TextBlock x:Name="SkipLabel" Text="Skip to break" />
                </Button>
                <Button x:Name="StopButton" Style="{StaticResource SkyTextButtonStyle}" Click="OnStop" Content="End session" />
            </StackPanel>
        </StackPanel>

        <!-- Today, quietly, bottom left -->
        <StackPanel x:Name="TodayRow" Orientation="Horizontal" Spacing="28" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="28,0,28,24">
            <TextBlock x:Name="TodayMinutes" Text="0 min today" Style="{StaticResource BodyMediumStyle}"
                       Foreground="{StaticResource OnSkySecondaryBrush}" VerticalAlignment="Center" />
            <StackPanel x:Name="CycleDots" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" />
            <TextBlock x:Name="StreakText" Style="{StaticResource BodyMediumStyle}"
                       Foreground="{StaticResource OnSkySecondaryBrush}" VerticalAlignment="Center" />
        </StackPanel>
    </Grid>
</Page>
