<Page
    x:Class="RepDayrise.Views.HabitsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RepDayrise.Controls"
    xmlns:services="using:RepDayrise.Services"
    xmlns:vm="using:RepDayrise.ViewModels"
    Background="{ThemeResource AppBackgroundBrush}">

    <!-- The day's habits as an inset grouped list, under a large title and a calendar-style week. -->
    <Page.Resources>
        <DataTemplate x:Key="HabitRowTemplate" x:DataType="vm:HabitRowViewModel">
            <Grid>
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Focus on this" Click="{x:Bind StartFocus}" Visibility="{x:Bind IsTimer, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE916;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Set value…" Click="{x:Bind SetExact}" Visibility="{x:Bind IsMeasurable, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EF;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Edit" Click="{x:Bind Edit}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Archive" Click="{x:Bind Archive}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Delete" Click="{x:Bind Delete}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The whole row opens the habit -->
                <Button Grid.ColumnSpan="2" Style="{StaticResource ListRowButtonStyle}" Padding="14,11,0,11"
                        Click="{x:Bind Open}" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="34" Height="34" CornerRadius="9" Background="{x:Bind ColorBrush, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="16" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,190,0">
                            <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource BodyLargeStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource BodySmallStyle}"
                                       Foreground="{ThemeResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Check -->
                <Button Grid.Column="1" Style="{StaticResource SoftButtonStyle}" Width="30" Height="30" Margin="0,0,16,0"
                        CornerRadius="15" Visibility="{x:Bind IsCheck, Mode=OneWay}"
                        Background="{x:Bind CheckBackground, Mode=OneWay}" BorderBrush="{x:Bind ColorBrush, Mode=OneWay}" BorderThickness="2"
                        Click="OnCheck" Tag="{x:Bind}" AutomationProperties.Name="{x:Bind CheckLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind CheckLabel, Mode=OneWay}">
                    <FontIcon Glyph="&#xE73E;" FontSize="13" Foreground="White" Opacity="{x:Bind CheckIconOpacity, Mode=OneWay}" />
                </Button>

                <!-- Count -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,12,0" Visibility="{x:Bind IsCount, Mode=OneWay}">
                    <Button Style="{StaticResource ChromeButtonStyle}" Width="32" CornerRadius="16"
                            Click="{x:Bind Decrement}" AutomationProperties.Name="Subtract one" ToolTipService.ToolTip="Subtract one">
                        <FontIcon Glyph="&#xE738;" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                    </Button>
                    <Grid Width="34" Height="34">
                        <ProgressRing IsIndeterminate="False" Value="{x:Bind Percent, Mode=OneWay}" Width="34" Height="34"
                                      Foreground="{x:Bind ColorBrush, Mode=OneWay}" Background="{ThemeResource DividerBrush}" />
                        <Button Style="{StaticResource SoftButtonStyle}" Width="28" Height="28" CornerRadius="14"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Click="OnIncrement" Tag="{x:Bind}" AutomationProperties.Name="Add one" ToolTipService.ToolTip="Add one">
                            <FontIcon Glyph="&#xE710;" FontSize="12" />
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Timer -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2" Margin="0,0,12,0" Visibility="{x:Bind IsTimer, Mode=OneWay}">
                    <TextBlock Text="{x:Bind TimerText, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,6,0"
                               Style="{StaticResource BodyMediumStyle}" />
                    <Button Style="{StaticResource ChromeButtonStyle}" Width="Auto" Padding="10,0" CornerRadius="16"
                            Visibility="{x:Bind TimerActive, Mode=OneWay}" Foreground="{ThemeResource PrimaryBrush}"
                            Click="{x:Bind FinishTimer}" AutomationProperties.Name="Stop and log" ToolTipService.ToolTip="Stop the timer and log its minutes">
                        <TextBlock Text="Log" Style="{StaticResource LabelLargeStyle}" />
                    </Button>
                    <Button Style="{StaticResource ChromeButtonStyle}" Width="32" CornerRadius="16"
                            Click="{x:Bind StartFocus}" AutomationProperties.Name="Focus on this" ToolTipService.ToolTip="Start a focus session for this habit">
                        <FontIcon Glyph="&#xE916;" FontSize="14" Foreground="{ThemeResource TextMutedBrush}" />
                    </Button>
                    <Grid Width="34" Height="34">
                        <ProgressRing IsIndeterminate="False" Value="{x:Bind Percent, Mode=OneWay}" Width="34" Height="34"
                                      Foreground="{x:Bind ColorBrush, Mode=OneWay}" Background="{ThemeResource DividerBrush}" />
                        <Button Style="{StaticResource SoftButtonStyle}" Width="28" Height="28" CornerRadius="14"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Click="{x:Bind ToggleTimer}" AutomationProperties.Name="Start or pause timer" ToolTipService.ToolTip="Start or pause the timer">
                            <FontIcon Glyph="{x:Bind TimerGlyph, Mode=OneWay}" FontSize="11" />
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Inset hairline between rows -->
                <Rectangle Grid.ColumnSpan="2" Height="1" VerticalAlignment="Bottom" Margin="62,0,0,0"
                           Fill="{ThemeResource DividerBrush}" Visibility="{x:Bind ShowDivider, Mode=OneWay}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SectionTemplate" x:DataType="vm:HabitSectionViewModel">
            <StackPanel Margin="0,0,0,22">
                <Button Visibility="{x:Bind HasHeader}" Style="{StaticResource SoftButtonStyle}" CornerRadius="6"
                        Margin="0,0,0,6" Padding="4,4,8,4" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                        Click="{x:Bind ToggleCollapsed}" services:Motion.Press="False">
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource TitleSmallStyle}" Foreground="{ThemeResource TextMutedBrush}" />
                            <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="9" Foreground="{ThemeResource TextMutedBrush}" />
                        </StackPanel>
                        <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource BodySmallStyle}"
                                   Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Right" />
                    </Grid>
                </Button>
                <Border Style="{StaticResource GroupedListStyle}" Visibility="{x:Bind IsExpanded, Mode=OneWay}">
                    <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource HabitRowTemplate}" />
                </Border>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer>
        <controls:ViewportPanel>
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
                <!-- Large title -->
                <Grid>
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Text="Today" Style="{StaticResource HeadlineLargeStyle}" />
                        <TextBlock x:Name="DateText" Style="{StaticResource BodyMediumStyle}" Foreground="{ThemeResource TextMutedBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BackToTodayButton" Content="Back to today" Click="OnBackToToday" Visibility="Collapsed" />
                        <Button Style="{StaticResource AccentButtonStyle}" Click="OnNewHabit" ToolTipService.ToolTip="Ctrl+N">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon Glyph="&#xE710;" FontSize="12" />
                                <TextBlock Text="New habit" />
                            </StackPanel>
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="N" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- The week -->
                <Grid x:Name="WeekStrip" Margin="-6,22,-6,20" />

                <!-- How the day is going -->
                <Grid x:Name="DayProgress" Margin="2,0,2,24" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ProgressBar x:Name="DayBar" Maximum="1" VerticalAlignment="Center" />
                    <TextBlock x:Name="ProgressText" Grid.Column="1" Style="{StaticResource BodySmallStyle}" Foreground="{ThemeResource TextMutedBrush}" />
                </Grid>

                <!-- Empty state -->
                <StackPanel x:Name="EmptyState" Spacing="10" Margin="0,40,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyTitle" Text="No habits yet" Style="{StaticResource HeadlineSmallStyle}" HorizontalAlignment="Center" />
                    <TextBlock x:Name="EmptyBody" TextAlignment="Center" MaxWidth="380" Style="{StaticResource BodyMediumStyle}"
                               Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Center" />
                    <Button x:Name="EmptyAddButton" Content="New habit" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Center"
                            Margin="0,8,0,0" Click="OnNewHabit" />
                </StackPanel>

                <ItemsControl x:Name="Sections" ItemTemplate="{StaticResource SectionTemplate}" />
            </StackPanel>
        </controls:ViewportPanel>
    </ScrollViewer>
</Page>
