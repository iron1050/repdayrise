<Page
    x:Class="RepDayrise.Views.HabitsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RepDayrise.Controls"
    xmlns:vm="using:RepDayrise.ViewModels"
    Background="{ThemeResource AppBackgroundBrush}"
    NavigationCacheMode="Required">

    <!--
        Port of the Android LIST view: a header tinted from indigo to green as the day fills, the week as day chips,
        then habit cards grouped like on the phone, each washed with its colour.
    -->
    <Page.Resources>
        <DataTemplate x:Key="HabitRowTemplate" x:DataType="vm:HabitRowViewModel">
            <Grid Margin="0,0,0,10" CornerRadius="20" Background="{ThemeResource CardBrush}"
                  BorderBrush="{ThemeResource CardBorderBrush}" BorderThickness="1">
                <Grid.ContextFlyout>
                    <MenuFlyout>
                        <MenuFlyoutItem Text="Focus on this" Click="{x:Bind StartFocus}" Visibility="{x:Bind IsTimer, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE916;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Set value…" Click="{x:Bind SetExact}" Visibility="{x:Bind IsMeasurable, Mode=OneWay}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8EF;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Edit" Click="{x:Bind Edit}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE70F;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutItem Text="Archive" Click="{x:Bind Archive}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7B8;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                        <MenuFlyoutSeparator />
                        <MenuFlyoutItem Text="Delete" Click="{x:Bind Delete}">
                            <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE74D;" /></MenuFlyoutItem.Icon>
                        </MenuFlyoutItem>
                    </MenuFlyout>
                </Grid.ContextFlyout>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- The habit's colour washes in from the left, as on Android -->
                <Border Grid.ColumnSpan="2" Background="{x:Bind WashBrush, Mode=OneWay}" IsHitTestVisible="False" />

                <Button Style="{StaticResource SoftButtonStyle}" Padding="14,12" CornerRadius="20"
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                        Click="{x:Bind Open}" AutomationProperties.Name="{x:Bind Name, Mode=OneWay}">
                    <Grid ColumnSpacing="14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="14" Background="{x:Bind ColorBrush, Mode=OneWay}">
                            <FontIcon Glyph="{x:Bind Glyph, Mode=OneWay}" FontSize="20" Foreground="White" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <TextBlock Text="{x:Bind Name, Mode=OneWay}" Style="{StaticResource TitleMediumStyle}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind StreakText, Mode=OneWay}" Style="{StaticResource LabelMediumStyle}"
                                           Foreground="{StaticResource FlameBrush}" VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{x:Bind Subtitle, Mode=OneWay}" Style="{StaticResource BodySmallStyle}"
                                       Foreground="{ThemeResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Button>

                <!-- Check -->
                <Button Grid.Column="1" Style="{StaticResource SoftButtonStyle}" Width="42" Height="42" Margin="0,0,16,0"
                        CornerRadius="21" Visibility="{x:Bind IsCheck, Mode=OneWay}"
                        Background="{x:Bind CheckBackground, Mode=OneWay}" BorderBrush="{x:Bind ColorBrush, Mode=OneWay}" BorderThickness="2"
                        Click="{x:Bind ToggleCheck}" AutomationProperties.Name="{x:Bind CheckLabel, Mode=OneWay}"
                        ToolTipService.ToolTip="{x:Bind CheckLabel, Mode=OneWay}">
                    <FontIcon Glyph="&#xE73E;" FontSize="16" Foreground="White" Opacity="{x:Bind CheckIconOpacity, Mode=OneWay}" />
                </Button>

                <!-- Count -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" Visibility="{x:Bind IsCount, Mode=OneWay}">
                    <Button Style="{StaticResource SoftButtonStyle}" Width="32" Height="32" CornerRadius="16"
                            Click="{x:Bind Decrement}" AutomationProperties.Name="Subtract one" ToolTipService.ToolTip="Subtract one">
                        <FontIcon Glyph="&#xE738;" FontSize="12" />
                    </Button>
                    <Grid Width="46" Height="46">
                        <ProgressRing IsIndeterminate="False" Value="{x:Bind Percent, Mode=OneWay}" Width="46" Height="46"
                                      Foreground="{x:Bind ColorBrush, Mode=OneWay}" Background="{ThemeResource OutlineBrush}" />
                        <Button Style="{StaticResource SoftButtonStyle}" Width="36" Height="36" CornerRadius="18"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Click="{x:Bind Increment}" AutomationProperties.Name="Add one" ToolTipService.ToolTip="Add one">
                            <FontIcon Glyph="&#xE710;" FontSize="14" />
                        </Button>
                    </Grid>
                </StackPanel>

                <!-- Timer -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" Margin="0,0,12,0" Visibility="{x:Bind IsTimer, Mode=OneWay}">
                    <TextBlock Text="{x:Bind TimerText, Mode=OneWay}" VerticalAlignment="Center" Margin="0,0,6,0"
                               Style="{StaticResource TitleSmallStyle}" />
                    <Button Style="{StaticResource SoftButtonStyle}" Height="32" CornerRadius="16" Padding="12,0"
                            Visibility="{x:Bind TimerActive, Mode=OneWay}" Foreground="{StaticResource SunriseBrush}"
                            Click="{x:Bind FinishTimer}" AutomationProperties.Name="Finish and log" ToolTipService.ToolTip="Finish and log">
                        <TextBlock Text="Finish" Style="{StaticResource LabelLargeStyle}" />
                    </Button>
                    <Button Style="{StaticResource SoftButtonStyle}" Width="32" Height="32" CornerRadius="16"
                            Click="{x:Bind StartFocus}" AutomationProperties.Name="Focus on this" ToolTipService.ToolTip="Start a focus session for this">
                        <FontIcon Glyph="&#xE916;" FontSize="14" />
                    </Button>
                    <Grid Width="46" Height="46">
                        <ProgressRing IsIndeterminate="False" Value="{x:Bind Percent, Mode=OneWay}" Width="46" Height="46"
                                      Foreground="{x:Bind ColorBrush, Mode=OneWay}" Background="{ThemeResource OutlineBrush}" />
                        <Button Style="{StaticResource SoftButtonStyle}" Width="36" Height="36" CornerRadius="18"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Click="{x:Bind ToggleTimer}" AutomationProperties.Name="Start or pause timer" ToolTipService.ToolTip="Start or pause the timer">
                            <FontIcon Glyph="{x:Bind TimerGlyph, Mode=OneWay}" FontSize="14" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SectionTemplate" x:DataType="vm:HabitSectionViewModel">
            <StackPanel>
                <Button Visibility="{x:Bind HasHeader}" Style="{StaticResource SoftButtonStyle}" CornerRadius="12"
                        Margin="0,10,0,8" Padding="6,6,12,6" HorizontalAlignment="Left" Click="{x:Bind ToggleCollapsed}">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="{x:Bind ChevronGlyph, Mode=OneWay}" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                        <TextBlock Text="{x:Bind Title, Mode=OneWay}" Style="{StaticResource TitleSmallStyle}" />
                        <Border Background="{ThemeResource SurfaceHighestBrush}" CornerRadius="9" Padding="8,1">
                            <TextBlock Text="{x:Bind Summary, Mode=OneWay}" Style="{StaticResource LabelMediumStyle}" Foreground="{ThemeResource TextMutedBrush}" />
                        </Border>
                    </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{x:Bind Rows}" ItemTemplate="{StaticResource HabitRowTemplate}"
                               Visibility="{x:Bind IsExpanded, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <!-- Tinted header that fades into the page -->
        <Border x:Name="HeaderTint" Height="300" VerticalAlignment="Top" IsHitTestVisible="False" />

        <ScrollViewer>
          <controls:ViewportPanel>
            <StackPanel MaxWidth="820" Padding="20,0,20,120">
                <!-- Title row, below the window's top buttons -->
                <TextBlock HorizontalAlignment="Center" Margin="0,14,0,0" Style="{StaticResource TitleLargeStyle}"
                           Foreground="White" IsHitTestVisible="False">
                    <Run x:Name="DayRelative" Text="Today" /><Run x:Name="DayDate" Foreground="#9EFFFFFF" />
                </TextBlock>

                <Grid Margin="4,40,4,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="ProgressText" Text="0 of 0 done" Foreground="White" Style="{StaticResource HeadlineMediumStyle}" />
                        <TextBlock x:Name="ProgressDetail" Foreground="#B3FFFFFF" Style="{StaticResource BodyMediumStyle}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="BackToTodayButton" Style="{StaticResource GlassPillButtonStyle}" Height="40" Content="Today"
                                Click="OnBackToToday" Visibility="Collapsed" />
                        <Button Style="{StaticResource GlassCircleButtonStyle}" Width="44" Height="44" CornerRadius="22" Click="OnNewHabit"
                                ToolTipService.ToolTip="New habit (Ctrl+N)" AutomationProperties.Name="New habit">
                            <FontIcon Glyph="&#xE710;" FontSize="16" />
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="N" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Week strip -->
                <Grid x:Name="WeekStrip" Margin="0,18,0,22" ColumnSpacing="6" />

                <!-- Empty state -->
                <Border x:Name="EmptyState" Style="{StaticResource DayriseCardStyle}" Margin="0,12,0,0" Padding="32" Visibility="Collapsed">
                    <StackPanel Spacing="14" HorizontalAlignment="Center">
                        <TextBlock Text="🌅" FontSize="44" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyTitle" Text="Your sky is still dark" Style="{StaticResource HeadlineSmallStyle}" HorizontalAlignment="Center" />
                        <TextBlock x:Name="EmptyBody" TextAlignment="Center" MaxWidth="420" Style="{StaticResource BodyMediumStyle}"
                                   Foreground="{ThemeResource TextMutedBrush}" HorizontalAlignment="Center" />
                        <Button x:Name="EmptyAddButton" Style="{StaticResource SunrisePillButtonStyle}" HorizontalAlignment="Center" Click="OnNewHabit">
                            <TextBlock Text="Create your first habit" />
                        </Button>
                    </StackPanel>
                </Border>

                <ItemsControl x:Name="Sections" ItemTemplate="{StaticResource SectionTemplate}" />
            </StackPanel>
          </controls:ViewportPanel>
        </ScrollViewer>
    </Grid>
</Page>
