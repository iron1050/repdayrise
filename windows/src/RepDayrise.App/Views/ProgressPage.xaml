<Page
    x:Class="RepDayrise.Views.ProgressPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:RepDayrise.Controls"
    xmlns:sky="using:RepDayrise.Controls.Sky"
    xmlns:views="using:RepDayrise.Views"
    Background="{ThemeResource AppBackgroundBrush}">

    <!-- How you're doing: today's sky, four numbers that matter, then focus and habits over time. -->
    <ScrollViewer>
        <controls:ViewportPanel>
            <StackPanel MaxWidth="{StaticResource PageMaxWidth}" Padding="{StaticResource PagePadding}">
                <TextBlock Text="Progress" Style="{StaticResource HeadlineLargeStyle}" />
                <TextBlock x:Name="DateText" Style="{StaticResource BodyMediumStyle}" Foreground="{ThemeResource TextMutedBrush}" />

                <!-- Today's sky, as a widget -->
                <Grid Height="220" Margin="0,22,0,0" CornerRadius="12">
                    <sky:SkyCanvas x:Name="Sky" HillFraction="0.2" Scrim="False" ClipRadius="12" />
                    <StackPanel VerticalAlignment="Bottom" Margin="22,0,22,18" Spacing="2">
                        <TextBlock x:Name="SkyHeadline" Foreground="White" Style="{StaticResource HeadlineMediumStyle}" />
                        <TextBlock x:Name="SkyDetail" Foreground="{StaticResource OnSkySecondaryBrush}" Style="{StaticResource BodyMediumStyle}" />
                    </StackPanel>
                </Grid>

                <!-- Four numbers -->
                <Border Style="{StaticResource GroupedListStyle}" Margin="0,16,0,0">
                    <Grid x:Name="Numbers">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <StackPanel Padding="18,14" Spacing="2">
                            <TextBlock Text="Focus today" Style="{StaticResource BodySmallStyle}" Foreground="{ThemeResource TextMutedBrush}" />
                            <TextBlock x:Name="FocusToday" Style="{StaticResource HeadlineSmallStyle}" />
                        </StackPanel>
                        <Rectangle Grid.Column="1" Width="1" Margin="0,14" Fill="{ThemeResource DividerBrush}" />
                        <StackPanel Grid.Column="2" Padding="18,14" Spacing="2">
                            <TextBlock Text="This week" Style="{StaticResource BodySmallStyle}" Foreground="{ThemeResource TextMutedBrush}" />
                            <TextBlock x:Name="FocusWeek" Style="{StaticResource HeadlineSmallStyle}" />
                        </StackPanel>
                        <Rectangle Grid.Column="3" Width="1" Margin="0,14" Fill="{ThemeResource DividerBrush}" />
                        <StackPanel Grid.Column="4" Padding="18,14" Spacing="2">
                            <TextBlock Text="Focus streak" Style="{StaticResource BodySmallStyle}" Foreground="{ThemeResource TextMutedBrush}" />
                            <TextBlock x:Name="FocusStreak" Style="{StaticResource HeadlineSmallStyle}" />
                        </StackPanel>
                        <Rectangle Grid.Column="5" Width="1" Margin="0,14" Fill="{ThemeResource DividerBrush}" />
                        <StackPanel Grid.Column="6" Padding="18,14" Spacing="2">
                            <TextBlock Text="Habits this month" Style="{StaticResource BodySmallStyle}" Foreground="{ThemeResource TextMutedBrush}" />
                            <TextBlock x:Name="MonthPercent" Style="{StaticResource HeadlineSmallStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Focus -->
                <Grid Margin="4,32,0,8">
                    <TextBlock Text="Focus" Style="{StaticResource TitleMediumStyle}" VerticalAlignment="Center" />
                    <HyperlinkButton Content="All sessions" HorizontalAlignment="Right" Padding="6,2" Click="OnSessionHistory" />
                </Grid>
                <Border Style="{StaticResource DayriseCardStyle}" Padding="20,18">
                    <StackPanel Spacing="18">
                        <Grid>
                            <TextBlock Text="Last two weeks" Style="{StaticResource BodySmallStyle}" Foreground="{ThemeResource TextMutedBrush}" />
                            <TextBlock x:Name="FocusTotal" HorizontalAlignment="Right" Style="{StaticResource BodySmallStyle}" Foreground="{ThemeResource TextMutedBrush}" />
                        </Grid>
                        <controls:BarChart x:Name="FocusBars" BarAreaHeight="110" />
                        <Rectangle Height="1" Fill="{ThemeResource DividerBrush}" />
                        <Grid>
                            <TextBlock Text="This year" Style="{StaticResource BodySmallStyle}" Foreground="{ThemeResource TextMutedBrush}" />
                            <TextBlock x:Name="FocusGoalText" HorizontalAlignment="Right" Style="{StaticResource BodySmallStyle}" Foreground="{ThemeResource TextMutedBrush}" />
                        </Grid>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <controls:ContributionGraph x:Name="FocusGraph" />
                        </ScrollViewer>
                        <StackPanel x:Name="FocusByHabit" Spacing="10" />
                    </StackPanel>
                </Border>

                <!-- Habits -->
                <TextBlock Text="Habits" Style="{StaticResource TitleMediumStyle}" Margin="4,32,0,8" />
                <Border Style="{StaticResource DayriseCardStyle}" Padding="20,18">
                    <StackPanel Spacing="14">
                        <Grid>
                            <TextBlock Text="The past year" Style="{StaticResource BodySmallStyle}" Foreground="{ThemeResource TextMutedBrush}" />
                            <TextBlock x:Name="SunriseCount" HorizontalAlignment="Right" Style="{StaticResource BodySmallStyle}" Foreground="{ThemeResource TextMutedBrush}" />
                        </Grid>
                        <ScrollViewer HorizontalScrollMode="Auto" HorizontalScrollBarVisibility="Auto" VerticalScrollMode="Disabled">
                            <controls:ContributionGraph x:Name="YearGraph" />
                        </ScrollViewer>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource GroupedListStyle}" Margin="0,12,0,0">
                    <ItemsControl x:Name="HabitList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="views:HabitSummary">
                                <Grid>
                                    <Button Style="{StaticResource ListRowButtonStyle}" Padding="14,11" Tag="{x:Bind Id}" Click="OnOpenHabit"
                                            AutomationProperties.Name="{x:Bind Name}">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="34" Height="34" CornerRadius="9" Background="{x:Bind Brush}">
                                                <FontIcon Glyph="{x:Bind Glyph}" FontSize="16" Foreground="White" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Name}" Style="{StaticResource BodyLargeStyle}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{x:Bind Detail}" Style="{StaticResource BodySmallStyle}" Foreground="{ThemeResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind MonthText}" Style="{StaticResource BodyMediumStyle}" Foreground="{ThemeResource TextMutedBrush}" />
                                                <FontIcon Glyph="&#xE76C;" FontSize="11" Foreground="{ThemeResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Rectangle Height="1" VerticalAlignment="Bottom" Margin="62,0,0,0" Fill="{ThemeResource DividerBrush}"
                                               Visibility="{x:Bind ShowDivider}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
                <TextBlock x:Name="NoHabits" Text="Habits you add show up here with their streaks." Visibility="Collapsed"
                           Style="{StaticResource BodyMediumStyle}" Foreground="{ThemeResource TextMutedBrush}" Margin="4,8,0,0" />
            </StackPanel>
        </controls:ViewportPanel>
    </ScrollViewer>
</Page>
